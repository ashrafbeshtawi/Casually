<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12 (API 31) and higher.
    The session prefs are encrypted with a Keystore key that is never backed up or
    transferred, so the file must not travel without it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="casually_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="casually_session.xml" />
    </device-transfer>
</data-extraction-rules>
